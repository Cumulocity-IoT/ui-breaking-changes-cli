{
  "name": "c8y-breaking-changes-cli",
  "version": "0.0.5",
  "description": "CLI to detect and list breaking changes between Cumulocity Web SDK versions",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "c8y-breaking-changes": "./dist/index.js"
  },
  "scripts": {
    "build": "pkgroll --minify --clean-dist",
    "prepack": "pkgroll --minify --clean-dist",
    "dev": "tsx src/index.ts",
    "check": "tsgo --noEmit",
    "lint": "biome lint src/",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260522.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "pkgroll": "^2.27.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
